# Copy to .env.docker and fill with Neon *test* credentials (never production).
# cp .env.docker.example .env.docker

# Neon branch/project dedicated to QA
# https://console.neon.tech → Connect
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Better Auth — openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-random-secret-at-least-32-chars"
# URL that QA opens in the browser
BETTER_AUTH_URL="http://localhost:3000"

# Resend — email flows need a real key; placeholders boot the app but won't send mail
RESEND_API_KEY="re_xxxxxxxx"
EMAIL_FROM="sclinic <onboarding@resend.dev>"

# Stripe test mode (optional for browsing; required for Checkout / Portal)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
