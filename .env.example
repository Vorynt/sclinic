# Neon Postgres — Console → Connect
# https://console.neon.tech
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-random-secret-at-least-32-chars"
# Local: http://localhost:3000
# Production (Vercel): https://sclinic-ten.vercel.app (or custom domain)
# Preview: optional — falls back to https://$VERCEL_URL when unset
BETTER_AUTH_URL="http://localhost:3000"

# Resend — https://resend.com/api-keys
# Dev can use: EMAIL_FROM="sclinic <onboarding@resend.dev>"
RESEND_API_KEY="re_xxxxxxxx"
EMAIL_FROM="sclinic <noreply@yourdomain.com>"

# Resend Templates — create & publish with these aliases in the dashboard:
#   email-verification | password-reset | collaborator-invite | professional-invite
# Copy/reference: src/core/email/templates/copy.ts

# Stripe — SaaS subscriptions (ADR-003). Optional in local demo without Checkout.
# https://dashboard.stripe.com/apikeys (use the same account as `stripe login`)
STRIPE_SECRET_KEY="sk_test_..."
# Webhook signing secret from `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET="whsec_..."
# After creating Products/Prices: npm run stripe:sync-plans

